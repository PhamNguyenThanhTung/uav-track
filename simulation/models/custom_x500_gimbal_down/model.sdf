<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="custom_x500_gimbal_down">
    <self_collide>false</self_collide>
    <static>false</static>

    <!-- Include standard X500 base model -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- Mount outside the +Y landing skid. The default yaw (-pi/2)
         looks toward +Y when pitched; a centered mount sees that skid. -->
    <link name="gimbal_mount_link">
      <pose relative_to="base_link">0 0.22 -0.08 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="gimbal_support_visual">
        <pose>0 -0.11 0.025 0 0 0</pose>
        <geometry>
          <box>
            <size>0.03 0.22 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
      <visual name="gimbal_mount_visual">
        <geometry>
          <cylinder>
            <radius>0.025</radius>
            <length>0.02</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1.0</ambient>
          <diffuse>0.2 0.2 0.2 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Joint connecting base_link to gimbal_mount_link -->
    <joint name="gimbal_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>gimbal_mount_link</child>
    </joint>

    <!-- Gimbal Yaw Link (Vertical Assembly) -->
    <link name="gimbal_yaw_link">
      <pose relative_to="gimbal_mount_link">0 0 -0.02 0 0 0</pose>
      <inertial>
        <mass>0.04</mass>
        <inertia>
          <ixx>0.00008</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00008</iyy>
          <iyz>0</iyz>
          <izz>0.00008</izz>
        </inertia>
      </inertial>
      <visual name="gimbal_yaw_visual">
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1.0</ambient>
          <diffuse>0.4 0.4 0.4 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Yaw Joint (3 DOF - Axis 1: Yaw -180 deg to +180 deg) -->
    <joint name="gimbal_yaw_joint" type="revolute">
      <parent>gimbal_mount_link</parent>
      <child>gimbal_yaw_link</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-3.14159265359</lower>
          <upper>3.14159265359</upper>
          <effort>10.0</effort>
          <velocity>5.0</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Gimbal Roll Link (Horizontal Assembly) -->
    <link name="gimbal_roll_link">
      <pose relative_to="gimbal_yaw_link">0 0 -0.02 0 0 0</pose>
      <inertial>
        <mass>0.03</mass>
        <inertia>
          <ixx>0.00005</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00005</iyy>
          <iyz>0</iyz>
          <izz>0.00005</izz>
        </inertia>
      </inertial>
      <visual name="gimbal_roll_visual">
        <geometry>
          <box>
            <size>0.04 0.04 0.02</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1.0</ambient>
          <diffuse>0.3 0.3 0.3 1.0</diffuse>
        </material>
      </visual>
    </link>

    <!-- Roll Joint (3 DOF - Axis 2: Roll -45 deg to +45 deg) -->
    <joint name="gimbal_roll_joint" type="revolute">
      <parent>gimbal_yaw_link</parent>
      <child>gimbal_roll_link</child>
      <axis>
        <xyz>1 0 0</xyz>
        <limit>
          <lower>-0.78539816339</lower>
          <upper>0.78539816339</upper>
          <effort>10.0</effort>
          <velocity>5.0</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Camera Link (Camera Body & Lens, Pitch Axis) -->
    <link name="camera_link">
      <pose relative_to="gimbal_roll_link">0 0 -0.025 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="camera_body_visual">
        <geometry>
          <box>
            <size>0.05 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1.0</ambient>
          <diffuse>0.1 0.1 0.1 1.0</diffuse>
        </material>
      </visual>
      <visual name="camera_lens_visual">
        <pose>0 0 -0.02 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.012</radius>
            <length>0.015</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.0 0.5 0.8 1.0</ambient>
          <diffuse>0.0 0.5 0.8 1.0</diffuse>
        </material>
      </visual>
      <collision name="camera_collision">
        <geometry>
          <box>
            <size>0.05 0.05 0.04</size>
          </box>
        </geometry>
      </collision>

      <!-- RGB Downward Camera Sensor -->
      <!-- Sensor optical axis points along -Z of camera_link (Straight Down) when pitch joint is 0° -->
      <sensor name="camera_sensor" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 -0.02 3.14159265359 1.57079632679 0</pose>
        <topic>custom_x500/camera/image_raw</topic>
        <camera>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>1000.0</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- Pitch Joint (3 DOF - Axis 3: Pitch 0 deg to +70 deg) -->
    <!-- 0 deg = camera looking straight down; +70 deg = tilted 60 deg up towards forward horizon -->
    <joint name="gimbal_pitch_joint" type="revolute">
      <parent>gimbal_roll_link</parent>
      <child>camera_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0.0</lower>
          <upper>1.2217304764</upper>
          <effort>10.0</effort>
          <velocity>5.0</velocity>
        </limit>
        <dynamics>
          <damping>0.1</damping>
          <friction>0.01</friction>
        </dynamics>
      </axis>
    </joint>

    <!-- Joint Position Controller Plugins for Gazebo Harmonic -->
    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_yaw_joint</joint_name>
      <sub_topic>custom_x500/gimbal/yaw_cmd</sub_topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.02</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_roll_joint</joint_name>
      <sub_topic>custom_x500/gimbal/roll_cmd</sub_topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.02</d_gain>
    </plugin>

    <plugin
      filename="gz-sim-joint-position-controller-system"
      name="gz::sim::systems::JointPositionController">
      <joint_name>gimbal_pitch_joint</joint_name>
      <sub_topic>custom_x500/gimbal/pitch_cmd</sub_topic>
      <p_gain>2.0</p_gain>
      <i_gain>0.05</i_gain>
      <d_gain>0.02</d_gain>
    </plugin>

    <!-- Joint State Publisher for Gimbal Joints -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
      <joint_name>gimbal_yaw_joint</joint_name>
      <joint_name>gimbal_roll_joint</joint_name>
      <joint_name>gimbal_pitch_joint</joint_name>
      <topic>model/custom_x500_gimbal_down/joint_states</topic>
    </plugin>

  </model>
</sdf>
